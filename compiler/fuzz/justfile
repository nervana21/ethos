# Bitcoin RPC Fuzzing - Justfile
# All fuzz runs through Docker. Never host cargo fuzz (see FUZZING-DOCKER.md).

# Default recipe - show available commands
default:
    @just --list

# Ensure persistent ethos-fuzz box
box:
    bash scripts/ensure-ethos-fuzz.sh

# Coverage-guided schema_oracle (Docker libFuzzer)
schema-oracle-cov *args:
    bash scripts/run-schema-oracle-cov.sh {{args}}

# Run fuzzing for a specific target and duration (compose one-shot)
fuzz-duration target duration="1h":
    @echo "Running fuzz target '{{target}}' for {{duration}} (Docker)"
    @bash -c 'DUR={{duration}}; case "$DUR" in *h) SECS=$(( ${DUR%h} * 3600 )) ;; *m) SECS=$(( ${DUR%m} * 60 )) ;; *s) SECS=$(( ${DUR%s} )) ;; *) SECS=$DUR ;; esac; docker compose run --rm fuzz bash -c "set -euo pipefail; export PATH=/usr/local/cargo/bin:\${PATH:-/usr/bin:/bin}; cd /work/compiler/fuzz && cargo +nightly fuzz run {{target}} -- -max_total_time=${SECS}"'

fuzz-1m target:
    @just fuzz-duration {{target}} 1m

fuzz-5m target:
    @just fuzz-duration {{target}} 5m

fuzz-1h target:
    @just fuzz-duration {{target}} 1h

# Smoke all cargo-fuzz targets in Docker (schema_oracle + schema alias)
fuzz-all:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Docker fuzz-all (schema_oracle) ==="
    bash scripts/ensure-ethos-fuzz.sh
    docker exec -i ethos-fuzz bash -c '
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:${PATH:-/usr/bin:/bin}"
    cd /work/compiler/fuzz
    export CARGO_PROFILE_RELEASE_LTO=false
    cargo +nightly fuzz build schema_oracle
    cargo +nightly fuzz run schema_oracle -- -max_total_time=7 -max_len=128
    '

# Docker-based fuzzing (recommended)
docker-fuzz target duration="1h":
    @just fuzz-duration {{target}} {{duration}}

examples:
    @echo "Examples:"
    @echo "  just box"
    @echo "  just schema-oracle-cov"
    @echo "  just schema-oracle-cov -- -max_total_time=60"
    @echo "  just fuzz-duration schema_oracle 5m"
    @echo "  just fuzz-all"
